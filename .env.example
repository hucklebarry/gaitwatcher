DATABASE_URL="postgresql://gaitwatcher:gaitwatcher@localhost:5433/gaitwatcher?schema=public"
CV_WORKER_URL=http://localhost:8000
QUEUE_MODE=memory
TEMP_MEDIA_RETENTION=false
RING_CLIENT_ID=
RING_CLIENT_SECRET=
REOLINK_HOST=
REOLINK_USERNAME=
REOLINK_PASSWORD=
# Optional: default is 8000. The supplied ONVIF endpoint must be reachable.
REOLINK_ONVIF_PORT=8000
# Optional: an audio file (WAV, MP3, etc.). If omitted, the spike sends a one-second tone.
REOLINK_AUDIO_FILE=
# Duplex test only: a persistent directory for microphone WAV recordings and report.json.
REOLINK_CAPTURE_DIR=
# Development-only remote-control proof. Use a long random value and never commit it.
REMOTE_CONTROL_TOKEN=
REMOTE_CONTROL_PORT=3100
HOME_AGENT_ID=dev-home-agent
HOME_AGENT_DEVICE_ID=living-room-reolink
HOME_AGENT_TOKEN=
HOME_AGENT_CLOUD_URL=
HOME_AGENT_RECONNECT_MS=5000
